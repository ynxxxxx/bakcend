# ==============================================================================
# TV Tracking Social Backend - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS. Copy this file to .env on your VPS / local host.
# File permissions should be set to 600: chmod 600 .env
# ==============================================================================

# Server & Domain Settings
NODE_ENV=production
APP_DOMAIN=tv.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
ANALYTICS_DOMAIN=analytics.yourdomain.com
STATUS_DOMAIN=status.yourdomain.com
CLOUDFLARE_IPS_ONLY=true

# Database (PostgreSQL 15+)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_random_db_password_min_32_chars

# Supabase Auth & JWT
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_strong_jwt_secret_min_64_chars
# Anon key & Service role key signed with the JWT_SECRET
ANON_KEY=replace_with_generated_anon_jwt_token
SERVICE_ROLE_KEY=replace_with_generated_service_role_jwt_token

# Google OAuth (PKCE Mobile & Web)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# TMDb API (Accessed exclusively through tmdb-proxy Edge Function)
TMDB_API_KEY=your_tmdb_v3_api_key

# Redis (Internal Private Docker Network Only)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# Moderation Worker (FastAPI)
MODERATION_WORKER_PORT=8000
MODERATION_SHARED_SECRET=replace_with_strong_worker_auth_token_for_edge_functions
MODERATION_ML_ENABLED=false
MODERATION_AUTO_REMOVE_THRESHOLD=0.9
MODERATION_HOLD_THRESHOLD=0.6

# Admin & Analytics (Appsmith & Metabase)
METABASE_DB_PASSWORD=replace_with_metabase_internal_db_password
METABASE_READONLY_USER=metabase_ro
METABASE_READONLY_PASSWORD=replace_with_metabase_readonly_postgres_password
UPTIME_KUMA_PORT=3001
APPSMITH_PORT=8080

# Logging & Monitoring
SENTRY_DSN=
