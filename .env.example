# ==============================================================================
# TV Tracking Social Backend - Environment Configuration Template
# Set permissions: chmod 600 .env
# Never commit real secrets.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Domains (Caddy Reverse Proxy)
APP_DOMAIN=tv.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# Supabase Connection (Compatible with Supabase Cloud or Self-Hosted VPS)
# When self-hosted on the same VPS, set to http://host.docker.internal:8000 or your internal gateway
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key

# SERVER-SIDE ONLY SECRETS (Never prefix with NEXT_PUBLIC_ or send to browser)
# Generate a 64+ char random string: openssl rand -base64 48
SUPABASE_SERVICE_ROLE_KEY=replace_with_secure_service_role_secret_key
ADMIN_SESSION_SECRET=replace_with_strong_random_session_secret_min_32_chars

# TMDb API (Server-side proxy only)
TMDB_API_KEY=replace_with_tmdb_v3_api_key

# Phase 3 Placeholders (Redis & Moderation Worker)
REDIS_PASSWORD=replace_with_strong_redis_password
MODERATION_SHARED_SECRET=replace_with_shared_worker_secret
